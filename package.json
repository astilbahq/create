{
  "name": "create-astilba",
  "version": "0.1.0",
  "description": "Create production-ready TypeScript projects with Astilba's maintained foundations.",
  "keywords": [
    "astilba",
    "astro",
    "cloudflare-workers",
    "scaffolding",
    "typescript",
    "vite"
  ],
  "homepage": "https://github.com/astilbahq/create#readme",
  "bugs": {
    "url": "https://github.com/astilbahq/create/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astilbahq/create.git"
  },
  "bin": {
    "create-astilba": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsx scripts/clean.ts && tsc -p tsconfig.build.json",
    "check": "ultracite check",
    "create": "tsx src/bin.ts",
    "fix": "ultracite fix",
    "generate:workflow-audit-fixture": "tsx scripts/generate-workflow-audit-fixture.ts",
    "knip": "knip",
    "test": "vitest run",
    "test:consumers": "tsx scripts/verify-consumers.ts",
    "test:package": "pnpm build && tsx scripts/verify-packed-package.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm knip && pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "knip": "6.26.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "ultracite": "7.9.4",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11.10.0"
  },
  "packageManager": "pnpm@11.10.0"
}
