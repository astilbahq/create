{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:astilba:create:catalog:1",
  "title": "Astilba Create recipe catalog",
  "description": "The versioned public recipe catalog emitted by create-astilba.",
  "type": "object",
  "additionalProperties": false,
  "required": ["command", "generator", "ok", "recipes", "schemaVersion"],
  "properties": {
    "command": {
      "const": "catalog"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "create-astilba"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        }
      }
    },
    "ok": {
      "const": true
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "id", "label", "version"],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "schemaVersion": {
      "const": 1
    }
  }
}
