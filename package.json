{
  "name": "typescript-foundation",
  "version": "0.0.0",
  "private": true,
  "description": "A deterministic, security-conscious foundation for TypeScript projects.",
  "license": "MIT",
  "bin": {
    "typescript-foundation": "./dist/bin.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "generate:workflow-audit-fixture": "tsx scripts/generate-workflow-audit-fixture.ts",
    "knip": "knip",
    "scaffold": "tsx src/bin.ts",
    "test": "vitest run",
    "test:consumers": "tsx scripts/verify-consumers.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm knip && pnpm build"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "knip": "6.26.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "ultracite": "7.9.4",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11.10.0"
  },
  "packageManager": "pnpm@11.10.0"
}
